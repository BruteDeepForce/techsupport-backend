{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Web (Chrome)",
      "request": "launch",
      "type": "dart",
      "program": "apps/mobile/lib/main.dart",
      "cwd": "apps/mobile",
      "deviceId": "chrome"
    },
    {
      "name": "Flutter Web (Edge)",
      "request": "launch",
      "type": "dart",
      "program": "apps/mobile/lib/main.dart",
      "cwd": "apps/mobile",
      "deviceId": "edge"
    },
    {
      "name": ".NET Backend",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/TechSupport.Web/bin/Debug/net9.0/TechSupport.Web.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/TechSupport.Web",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    }
  ]
}
