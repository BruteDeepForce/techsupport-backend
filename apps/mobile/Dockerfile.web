# Stage 1: Build
FROM ghcr.io/cirruslabs/flutter:stable AS build

# Sets the work directory in the build container
WORKDIR /app

# Dokploy Recommended Setup:
# Docker Context Path: apps/mobile
# Docker File: Dockerfile.web
# Copy everything from the context (which is apps/mobile)
COPY . .

# Enable web support in Flutter
RUN flutter config --enable-web

# Get project dependencies
RUN flutter pub get

# Build the web application in release mode
RUN flutter build web --release

# Stage 2: Serve using Nginx
FROM nginx:stable-alpine

# Copy the compiled web assets to Nginx's public directory
COPY --from=build /app/build/web /usr/share/nginx/html

# Copy the SPA-optimized Nginx configuration from the build stage
COPY --from=build /app/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
